{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moto Rezzio",
  "version": "1.0.0",
  "identifier": "com.jacobs.motorezzio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moto Rezzio - Sistema de Gestión",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/96x96.png",
      "icons/180x180.png",
      "icons/192x192.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Jacobsdev",
    "shortDescription": "Sistema de gestión de inventario y taller",
    "copyright": "© 2026 Moto Rezzio",
    "windows": {
      "wix": {
        "language": [
          "es-ES"
        ]
      },
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        
        "headerImage": "icons/installer-header.bmp",
        "displayLanguageSelector": false
      }
    }
  }
}