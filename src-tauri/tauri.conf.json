{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moto Rezzio",
  "version": "1.0.0",
  "identifier": "com.jacobs.motorezzio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moto Rezzio - Sistema de Gestión",
        "width": 1400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jacobs",
    "shortDescription": "Sistema de gestión de inventario y taller",
    "copyright": "© 2026 Moto Rezzio",
    "windows": {
      "wix": {
        "language": [
          "es-ES"
        ]
      },
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}